#!/bin/zsh
# hal-progress v12 — accumulating rich iMessage progress bubbles
# Format: header + accumulated → step lines ending with auto ✅ Done summary
PHONE="+12269983286"
CHAT="iMessage;-;+12269983286"
IMSG="/usr/local/bin/imsg"
DB="/Users/hal9000/Library/Messages/chat.db"
STATE_DIR="/tmp/hal-progress-state"
CUR_FILE="/tmp/hal-progress-current"
MANUAL_FLAG="/tmp/hal-progress-manual"
mkdir -p "$STATE_DIR"

_sql() { sqlite3 "$DB" "$1" 2>/dev/null; }

_git_nums() {
  local f=0 i=0 d=0 repo out rf ri rd
  for repo in /Users/hal9000/friday-pro /Users/hal9000/.openclaw/workspace; do
    out=$(git -C "$repo" diff --shortstat HEAD 2>/dev/null)
    [[ -z $out ]] && out=$(git -C "$repo" diff --shortstat 2>/dev/null)
    rf=$(echo "$out" | grep -oE '[0-9]+ file' | grep -oE '[0-9]+')
    ri=$(echo "$out" | grep -oE '[0-9]+ insertion' | grep -oE '[0-9]+')
    rd=$(echo "$out" | grep -oE '[0-9]+ deletion' | grep -oE '[0-9]+')
    f=$((f+${rf:-0})); i=$((i+${ri:-0})); d=$((d+${rd:-0}))
  done
  echo "$f $i $d"
}

_last_user_guid() { _sql "SELECT guid FROM message WHERE is_from_me=0 ORDER BY rowid DESC LIMIT 1;"; }

_send_bubble() {
  local TEXT="$1" REPLY_TO="${2:-$(_last_user_guid)}" BEFORE
  BEFORE=$(_sql "SELECT COALESCE(MAX(rowid),0) FROM message WHERE is_from_me=1;")
  if [[ -n $REPLY_TO ]]; then
    "$IMSG" send-rich --chat "$CHAT" --reply-to "$REPLY_TO" --text "$TEXT" >/dev/null 2>&1
    if [[ $? -eq 0 ]]; then
      sleep 1.2
      _sql "SELECT guid FROM message WHERE is_from_me=1 AND rowid>${BEFORE:-0} ORDER BY rowid DESC LIMIT 1;"
      return
    fi
  fi
  osascript -e "tell application \"Messages\" to send \"$TEXT\" to buddy \"$PHONE\" of (first service whose service type = iMessage)" >/dev/null 2>&1
  sleep 1.2
  _sql "SELECT guid FROM message WHERE is_from_me=1 AND rowid>${BEFORE:-0} ORDER BY rowid DESC LIMIT 1;"
}

_edit_bubble() { "$IMSG" edit --chat "$CHAT" --message "$1" --new-text "$2" --json >/dev/null 2>&1; }

_embody() {
  case "$1" in
    exec|run)      echo "⚙️ exec" ;;
    thinking)      echo "🧠 thinking" ;;
    found)         echo "🔍 found" ;;
    editing|edit)  echo "📝 editing" ;;
    error|fail)    echo "❌ error" ;;
    done)          echo "✅ done" ;;
    *)             echo "$1" ;;
  esac
}

_compose() {
  local HEADER STEPS
  HEADER=$(cat "$STATE_DIR/$1.txt" 2>/dev/null)
  STEPS=$(cat "$STATE_DIR/$1.steps" 2>/dev/null)
  if [[ -n $STEPS ]]; then printf "%s\n\n%s" "$HEADER" "$STEPS"
  else printf "%s" "$HEADER"; fi
}

case $1 in
  start)
    # start "Header text" [reply_to_guid]
    HEADER="⏳ ${2:-(working)}"
    REPLY_TO="${3:-$(_last_user_guid)}"
    # Always send a fresh bubble — sidecar v12 is typing-only, nothing to adopt
    GUID=$(_send_bubble "$HEADER" "$REPLY_TO")
    if [[ -n $GUID && ${#GUID} -lt 50 && $GUID != *"{{"* ]]; then
      printf "%s" "$HEADER" > "$STATE_DIR/$GUID.txt"
      printf "" > "$STATE_DIR/$GUID.steps"
      date +%s > "$STATE_DIR/$GUID.start"
      _git_nums > "$STATE_DIR/$GUID.snap"
      : > "$MANUAL_FLAG"
      echo "$GUID"
    fi ;;

  update)
    [[ -z $2 ]] && exit 0
    if [[ -n $4 || $3 == exec || $3 == run || $3 == thinking || $3 == found || $3 == editing || $3 == edit || $3 == done || $3 == error ]]; then
      LABEL=$(_embody "$3")
      printf "→ (%s): %s\n" "$LABEL" "$4" >> "$STATE_DIR/$2.steps"
    else
      printf "→ %s\n" "$3" >> "$STATE_DIR/$2.steps"
    fi
    _edit_bubble "$2" "$(_compose $2)" ;;

  done)
    if [[ -n $3 ]]; then
      printf "→ %s\n" "$3" >> "$STATE_DIR/$2.steps"
    else
      START=$(cat "$STATE_DIR/$2.start" 2>/dev/null); START=${START:-$(date +%s)}
      SECS=$(( $(date +%s) - START )); [[ $SECS -lt 1 ]] && SECS=1
      read SF SI SD < "$STATE_DIR/$2.snap" 2>/dev/null; SF=${SF:-0}; SI=${SI:-0}; SD=${SD:-0}
      read EF EI ED <<< "$(_git_nums)"
      DF=$((EF-SF)); DI=$((EI-SI)); DD=$((ED-SD))
      [[ $DF -lt 0 ]] && DF=0; [[ $DI -lt 0 ]] && DI=0; [[ $DD -lt 0 ]] && DD=0
      S="✅ Done · "
      if [[ $DF -gt 0 ]]; then
        S+="📝 $DF file"; [[ $DF -ne 1 ]] && S+="s"
        [[ $DI -gt 0 ]] && S+=" +$DI"; [[ $DD -gt 0 ]] && S+=" -$DD"; S+=" · "
      fi
      S+="${SECS}s"
      printf "→ %s\n" "$S" >> "$STATE_DIR/$2.steps"
    fi
    _edit_bubble "$2" "$(_compose $2)"
    rm -f "$STATE_DIR/${2}.txt" "$STATE_DIR/${2}.steps" "$STATE_DIR/${2}.start" "$STATE_DIR/${2}.snap" "$MANUAL_FLAG" 2>/dev/null ;;

  run)
    # run GUID "description" command [args...]
    GUID="$2"; DESC="$3"; shift 3
    printf "→ (⚙️ exec): %s\n" "$DESC" >> "$STATE_DIR/$GUID.steps"
    _edit_bubble "$GUID" "$(_compose $GUID)"
    OUT=$(eval "$@" 2>&1); EXIT=$?
    FIRST=$(echo "$OUT" | grep -v '^$' | head -1 | cut -c1-80)
    if [[ $EXIT -eq 0 ]]; then
      printf "→ (🔍 found): %s\n" "${FIRST:-✓}" >> "$STATE_DIR/$GUID.steps"
    else
      printf "→ (❌ error): %s\n" "${FIRST:-exit $EXIT}" >> "$STATE_DIR/$GUID.steps"
    fi
    _edit_bubble "$GUID" "$(_compose $GUID)"
    echo "$OUT" ;;

  header)
    [[ -z $2 || -z $3 ]] && exit 0
    NEWH="⏳ $3"
    printf "%s" "$NEWH" > "$STATE_DIR/$2.txt"
    printf "" > "$STATE_DIR/$2.steps"
    _edit_bubble "$2" "$NEWH" ;;

  check-deleted)
    [[ -z $2 ]] && exit 0
    R=$(_sql "SELECT COUNT(*) FROM message WHERE guid='$2' AND date_retracted IS NOT NULL AND date_retracted!=0;")
    [[ ${R:-0} -gt 0 ]] && echo deleted && exit 1; echo exists ;;

  *) echo "Usage: hal-progress start|update|run|done|header|check-deleted" >&2; exit 1 ;;
esac

