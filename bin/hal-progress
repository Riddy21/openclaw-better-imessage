#!/bin/zsh
PHONE="+12269983286"
CHAT="iMessage;-;+12269983286"
IMSG="/usr/local/bin/imsg"
DB="/Users/hal9000/Library/Messages/chat.db"
STATE_DIR="/tmp/hal-progress-state"
mkdir -p "$STATE_DIR"

_reply_guid() { sqlite3 "$DB" "SELECT guid FROM message WHERE is_from_me=0 ORDER BY rowid DESC LIMIT 1;" 2>/dev/null; }

_send_bubble() {
  local TEXT="$1" BEFORE RG
  BEFORE=$(sqlite3 "$DB" "SELECT COALESCE(MAX(rowid),0) FROM message WHERE is_from_me=1;" 2>/dev/null || echo 0)
  RG=$(_reply_guid)
  if [[ -n $RG ]]; then
    "$IMSG" send-rich --chat "$CHAT" --reply-to "$RG" --text "$TEXT" >/dev/null 2>&1
    if [[ $? -eq 0 ]]; then sleep 1.2; sqlite3 "$DB" "SELECT guid FROM message WHERE is_from_me=1 AND rowid>$BEFORE ORDER BY rowid DESC LIMIT 1;" 2>/dev/null; return; fi
  fi
  osascript -e 'tell application "Messages" to send "'$TEXT'" to buddy "$PHONE" of (first service whose service type = iMessage)' >/dev/null 2>&1
  sleep 1.2
  sqlite3 "$DB" "SELECT guid FROM message WHERE is_from_me=1 AND rowid>$BEFORE ORDER BY rowid DESC LIMIT 1;" 2>/dev/null
}

case $1 in
  start)
    HEADER="⏳ ${2:-(working)}"
    GUID=$(_send_bubble "$HEADER")
    if [[ -n $GUID && ${#GUID} -lt 50 && $GUID != *"{{"* ]]; then
      printf "%s" "$HEADER" > "$STATE_DIR/$GUID.txt"
      echo "$GUID"
    fi ;;
  update)
    [[ -z $2 || -z $3 ]] && exit 0
    HEADER=$(cat "$STATE_DIR/$2.txt" 2>/dev/null)
    [[ -z $HEADER ]] && HEADER="⏳ Working..."
    "$IMSG" edit --chat "$CHAT" --message "$2" --new-text "$(printf "%s\n\n%s" "$HEADER" "$3")" --json >/dev/null 2>&1 ;;
  done) rm -f "$STATE_DIR/${2}.txt" 2>/dev/null ;;
  check-deleted)
    [[ -z $2 ]] && exit 0
    R=$(sqlite3 "$DB" "SELECT COUNT(*) FROM message WHERE guid='$2' AND date_retracted IS NOT NULL AND date_retracted!=0;" 2>/dev/null)
    [[ $R -gt 0 ]] && echo deleted && exit 1; echo exists ;;
  *) echo "Usage: hal-progress start|update|done|check-deleted" >&2; exit 1 ;;
esac
